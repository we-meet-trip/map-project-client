# 앱 빌드값(dart-define) 목록. 모두 비어 있어도 개발 빌드는 돈다(로컬 서버 http://localhost:8080).
# 복사해 값을 채운 뒤 `flutter run --dart-define-from-file=.env` 처럼 넘긴다. .env 는 git 에서 제외된다.
# 키는 모두 클라이언트용(앱에 실리는) 값이다. 서버 키를 넣지 않는다.

# 빌드 환경: test(기본, 번들 ID map.project.client.dev) 또는 prod(map.project.client)
CLIENT_APP_ENV=
# 개발용 고정 서버 주소. 주면 원격 설정을 읽지 않는다.
CLIENT_API_BASE_URL=
# 릴리스 빌드가 믿을 서버 origin 목록(쉼표 구분). prod 는 필수.
CLIENT_API_ALLOWED_ORIGINS=
# 서버 주소를 적어 두는 원격 설정 문서(JSON) 주소. 비우면 원격 조회를 하지 않는다.
CLIENT_APP_CONFIG_URL=
# https 초대 링크 origin. user 서버의 초대 기준 주소와 같은 origin 으로 준다. 비우면 앱 전용 스킴만 쓴다.
CLIENT_INVITE_LINK_ORIGIN=
# 약관·개인정보 문서를 /legal/*.html 로 둔 사이트 origin. 비우면 약관 메뉴를 감춘다.
CLIENT_PUBLIC_SITE_ORIGIN=
# 문의 메일 주소. 비우면 고객센터·문의하기를 감춘다.
CLIENT_SUPPORT_EMAIL=
# 카카오 네이티브 앱 키(카카오 로그인). prod 빌드는 필수.
CLIENT_KAKAO_NATIVE_APP_KEY=
# Google Maps 플랫폼별 클라이언트 키. 비우면 지도 타일이 뜨지 않고 나머지 화면은 돈다.
CLIENT_GOOGLE_MAPS_ANDROID_API_KEY=
CLIENT_GOOGLE_MAPS_IOS_API_KEY=
CLIENT_GOOGLE_MAPS_WEB_API_KEY=
# 카메라 인식(Vision) 개발 서버 host:port. debug 빌드에서만 쓴다.
CLIENT_VISION_SERVER_HOST=

# === OS ===
.DS_Store
Thumbs.db

# === IDE ===
.idea/
.vscode/
*.iml
*.iws
*.ipr

# === Env ===
# 이름이 .env 로 시작하는 것은 전부 제외한다. 빌드 도중 만들어지는 사본이나
# 파일 관리자가 남기는 중복본(".env 2" 같은)까지 걸러야, 키가 든 파일이
# 실수로 올라가는 일을 막을 수 있다.
.env*
!.env.example
map-android.json
map-ios.json

# === Dart / Flutter ===
# See https://www.dartlang.org/guides/libraries/private-files

# Files and directories created by pub
.dart_tool/
.packages
build/
# pubspec.lock 은 추적한다(아래 무시 목록에서 뺐다). 배포되는 앱이라 어떤
# 버전으로 만들어졌는지가 남아야 한다. 기록이 없으면 빌드 서버가 매번 새로
# 버전을 고르고, 어제 되던 빌드가 오늘 깨져도 무엇이 바뀌었는지 되짚을 수 없다.

# Directory created by dartdoc
doc/api/

# Avoid committing generated Javascript files:
*.dart.js
*.info.json
*.js
*.js_
*.js.deps
*.js.map

# Code generation outputs
*.g.dart
*.freezed.dart

# Flutter plugins metadata
.flutter-plugins
.flutter-plugins-dependencies

# === Android ===
android/.gradle/
android/captures/
android/local.properties
android/key.properties
android/app/debug/
android/app/profile/
android/app/release/
*.jks
*.keystore

# === iOS ===
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/DartDefines.xcconfig
ios/Flutter/ApiKeys.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Runner/GeneratedPluginRegistrant.*
*.mode1v3
*.mode2v3
*.perspectivev3
*.pbxuser
*.xccheckout
xcuserdata/
DerivedData/

# === macOS / Linux / Windows desktop ===
macos/Flutter/ephemeral/
linux/flutter/ephemeral/
windows/flutter/ephemeral/

# === Web ===

# === Coverage ===
coverage/

# === Misc ===
*.bak
*.tmp
*.log
__pycache__/
*.pyc
